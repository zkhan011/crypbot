# Copy to a protected production secret store; never commit a populated version.
CRYPBOT_ENVIRONMENT=production
CRYPBOT_EXECUTION_MODE=MOCK
CRYPBOT_ENABLE_LIVE_TRADING=false
# Deprecated compatibility flag; CRYPBOT_ENABLE_LIVE_TRADING is authoritative.
CRYPBOT_LIVE_TRADING_ENV_ENABLED=false
CRYPBOT_SEED_DEMO_USERS=false
CRYPBOT_PRODUCTION_BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
CRYPBOT_JWT_SECRET=replace-with-a-long-random-secret-from-a-secret-manager
CRYPBOT_CREDENTIAL_MASTER_KEY=replace-with-a-kms-managed-32-byte-key
CRYPBOT_DATABASE_URL=postgresql+psycopg://crypbot:replace-me@postgres:5432/crypbot
CRYPBOT_REDIS_URL=redis://redis:6379/0
CRYPBOT_BINGX_BASE_URL=https://open-api.bingx.com
CRYPBOT_BINGX_ENVIRONMENT=DEMO
CRYPBOT_BINGX_DEFAULT_PRODUCT=USDT_M_PERPETUAL
CRYPBOT_BINGX_DRY_RUN=true
CRYPBOT_BINGX_LIVE_CONFIRMATION=false
CRYPBOT_BINGX_TIMEOUT_SECONDS=10
CRYPBOT_BINGX_MAX_RETRIES=2
CRYPBOT_BINGX_RECV_WINDOW_MS=5000
CRYPBOT_BINGX_RULE_CACHE_TTL_SECONDS=300
CRYPBOT_BINGX_WEBSOCKET_STALE_SECONDS=15
CRYPBOT_BINGX_RECONCILIATION_INTERVAL_SECONDS=30
# Runtime BingX credentials must be injected by a secret manager, never committed populated.
# BINGX_API_KEY=replace-with-secret-manager-injection
# BINGX_API_SECRET=replace-with-secret-manager-injection
BINGX_ENVIRONMENT=DEMO
# BINGX_BASE_URL=replace-with-verified-demo-url
BINGX_RECV_WINDOW=5000
